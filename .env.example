# ==============================================
# 知识库问答系统 - 环境变量配置模板
# 使用方法：复制本文件为 .env，然后填写以下配置
# ==============================================

# ---- 必填：DeepSeek 大模型 API ----
# 获取 Key: https://platform.deepseek.com/  (API Keys 页面)
OPENAI_API_KEY=sk-你的DeepSeek_API_Key

# ---- 一般无需修改 ----
OPENAI_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat

# Embedding 使用本地模型（@xenova/transformers），无需 API Key
# 首次使用自动从镜像下载模型，Docker 构建时已预置
HF_ENDPOINT=https://hf-mirror.com

# ---- 数据库（Docker Compose 方式会自动配置，本地开发才需要改）----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_knowledge_base

# ---- 登录认证 ----
# 会话签名密钥：请改成一段随机长字符串，生产环境务必设置（不设置则用内置默认值）
AUTH_SECRET=请改成随机的长字符串
# 首次初始化数据库时创建的管理员账号（默认 admin / admin123，请及时修改）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123

# ---- RAG 配置（一般保持默认）----
CHUNK_SIZE=800
CHUNK_OVERLAP=200
# 检索片段数：Excel 类大表格会被切成几百个片段，取值过小会导致回答遗漏
TOP_K=15
# 关键词检索补充的片段数（用于精确匹配 A101 这类编号）
KEYWORD_TOP_K=30
# 送入模型的最大片段数（向量 + 关键词去重后）
MAX_CONTEXT_CHUNKS=30

# ---- 仅在网络被代理拦截（报证书错误 unable to verify the first certificate）时启用 ----
# NODE_TLS_REJECT_UNAUTHORIZED=0
